{% raw %}
<div class="container">
            <a href="/collections/all" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Zurück zum Shop
            </a>
            
            <div class="legal-divider"></div>

            <!-- Versandkosten -->
            <div class="legal-section">
                <h2>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    Versandkosten
                </h2>
                <div class="info-grid">
                    <div class="info-card">
                        <h3>🇨🇭 Schweiz</h3>
                        <ul>
                            <li><strong>Standard:</strong> CHF 7.90</li>
                            <li><strong>Gratis ab:</strong> CHF 100.–</li>
                            <li><strong>Express:</strong> + CHF 12.–</li>
                        </ul>
                    </div>
                    <div class="info-card">
                        <h3>🇪🇺 Europa (EU)</h3>
                        <ul>
                            <li><strong>Standard:</strong> CHF 15.90</li>
                            <li><strong>Gratis ab:</strong> CHF 150.–</li>
                            <li><strong>Express:</strong> + CHF 12.–</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Lieferzeiten -->
            <div class="legal-section">
                <h2>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Lieferzeiten
                </h2>
                <ul>
                    <li><strong>Schweiz:</strong> Die voraussichtliche Lieferzeit wird vor dem Verkaufsstart ergänzt.</li>
                    <li><strong>EU:</strong> Die voraussichtliche Lieferzeit wird vor dem Verkaufsstart ergänzt.</li>
                </ul>
                <p>Verbindliche Lieferzeiten und Versandabläufe werden vor dem Verkaufsstart veröffentlicht.</p>
            </div>

            <!-- Versandpartner -->
            <div class="legal-section">
                <h2>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    Versandpartner
                </h2>
                <p>Wir versenden mit <strong>Swiss Post</strong> (Schweiz) und <strong>DHL</strong> (International). Du erhältst nach dem Versand eine E-Mail mit Tracking-Link.</p>
            </div>

            <!-- Rückgaberecht -->
            <div class="legal-section">
                <h2>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Rückgaberecht
                </h2>
                <ul>
                    <li><strong>Rückgabefrist:</strong> 14 Tage ab Erhalt der Ware</li>
                    <li><strong>Kosten (CH):</strong> Kostenlose Retoure</li>
                    <li><strong>Kosten (EU):</strong> Rücksendekosten trägt der Käufer</li>
                    <li><strong>Zustand:</strong> Artikel ungetragen, ungewaschen, mit Originaletiketten</li>
                    <li><strong>Rückerstattung:</strong> Innerhalb von 5–7 Werktagen nach Eingang der Retoure</li>
                </ul>
            </div>

            <!-- Retourenprozess -->
            <div class="legal-section">
                <h2>Retourenprozess</h2>
                <ol>
                    <li>Stelle deine Anfrage innerhalb von 14 Tagen nach Erhalt über das <a href="#return-request">Retourenformular</a>.</li>
                    <li>Wir melden uns unter <a href="mailto:support@joumonde.com">support@joumonde.com</a> mit den nächsten Schritten.</li>
                    <li>Verpacke die Ware sorgfältig und sende sie nach unserer Rückmeldung zurück.</li>
                    <li>Nach Eingang und Prüfung der Ware erfolgt die Rückerstattung gemäss unseren Rückgabebedingungen.</li>
                </ol>
            </div>

            <!-- Kontakt -->
            <div class="legal-section">
                <h2>Fragen zum Versand?</h2>
                <p>Schreib uns jederzeit: <a href="mailto:support@joumonde.com">support@joumonde.com</a> | <a href="tel:+41765230204">076 523 02 04</a></p>
            </div>
            <div class="legal-section" id="return-request">
                <h2>Retoure anmelden</h2>
                <p>Nutze dieses Formular, um deine Rückgabe anzufragen. Wir stimmen die Rücksendung anschließend per E-Mail mit dir ab.</p>
                <p>Für Retouren schreibe uns an <a href="mailto:support@joumonde.com">support@joumonde.com</a> mit deiner Bestellnummer.</p>
            </div>
        </div>
{% endraw %}
