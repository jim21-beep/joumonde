<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% if current_page != 1 %} – Seite {{ current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{{ 'joumonde-logo.png' | asset_url }}">
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ 'site-footer.css' | asset_url | stylesheet_tag }}
  {{ 'site-pages.css' | asset_url | stylesheet_tag }}
  {{ 'theme-extra.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  {% section 'header' %}
  {{ content_for_layout }}
  {% section 'footer' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
