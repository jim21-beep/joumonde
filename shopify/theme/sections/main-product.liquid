{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="product-detail-section" data-product data-currency="{{ cart.currency.iso_code }}">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      {%- if collection != blank and collection.handle != 'all' -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span>/</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </div>

    <div class="product-detail-content">
      <div class="product-gallery">
        <div class="gallery-main">
          <div class="main-image" id="mainImage" style="background: #f5f5f5;">
            {%- if product.images.size > 0 -%}
              <img src="{{ product.images.first | image_url: width: 1400 }}" alt="{{ product.images.first.alt | default: product.title | escape }}" width="1400" data-gallery-main style="width: 100%; height: 100%; object-fit: cover;">
            {%- endif -%}
          </div>
        </div>
        {%- if product.images.size > 1 -%}
        <div class="gallery-thumbnails">
          {%- for image in product.images -%}
            <button type="button" class="thumbnail{% if forloop.first %} active{% endif %}" data-thumb="{{ image | image_url: width: 1400 }}" aria-label="Produktbild {{ forloop.index }} anzeigen">
              <img src="{{ image | image_url: width: 240 }}" alt="" loading="lazy" width="240" style="width: 100%; height: 100%; object-fit: cover;">
            </button>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      <div class="product-detail-info">
        <h1 class="product-detail-title">{{ product.title }}</h1>
        <div class="product-detail-price">
          <span class="current-price" data-price>{{ current_variant.price | money }}</span>
          <span class="price-vat">inkl. MwSt., zzgl. Versand</span>
        </div>

        {%- form 'product', product, class: 'jm-product-form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign oname = option.name | downcase -%}
              {%- assign opos = forloop.index0 -%}
              {%- if oname == 'farbe' or oname == 'color' -%}
                <div class="product-detail-color">
                  <label>{{ option.name }}: <span data-selected-label="{{ opos }}">{{ option.selected_value }}</span></label>
                  <div class="color-options-detail">
                    {%- for value in option.values -%}
                      {%- assign v = value | downcase -%}
                      {%- case v -%}
                        {%- when 'schwarz', 'black' -%}{%- assign hex = '#000000' -%}
                        {%- when 'weiß', 'weiss', 'white' -%}{%- assign hex = '#ffffff' -%}
                        {%- when 'navy' -%}{%- assign hex = '#001f3f' -%}
                        {%- when 'grau', 'gray', 'grey' -%}{%- assign hex = '#808080' -%}
                        {%- when 'beige' -%}{%- assign hex = '#f5f5dc' -%}
                        {%- when 'burgundy' -%}{%- assign hex = '#800020' -%}
                        {%- when 'camel' -%}{%- assign hex = '#C19A6B' -%}
                        {%- when 'braun', 'brown' -%}{%- assign hex = '#6b4a2f' -%}
                        {%- when 'blau', 'blue' -%}{%- assign hex = '#2f5d9e' -%}
                        {%- when 'oliv', 'olive' -%}{%- assign hex = '#6b6b3a' -%}
                        {%- else -%}{%- assign hex = '#c8c8c8' -%}
                      {%- endcase -%}
                      <button type="button" class="color-option{% if option.selected_value == value %} active{% endif %}" data-option-index="{{ opos }}" data-value="{{ value | escape }}" style="background: {{ hex }};{% if hex == '#ffffff' %} border: 1px solid #ddd;{% endif %}" title="{{ value | escape }}" aria-label="{{ option.name }} {{ value | escape }} wählen"></button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- elsif oname == 'größe' or oname == 'grösse' or oname == 'size' -%}
                <div class="product-detail-size">
                  <label>{{ option.name }}: <span data-selected-label="{{ opos }}">{{ option.selected_value }}</span></label>
                  <div class="size-options-grid">
                    {%- for value in option.values -%}
                      <button type="button" class="size-option{% if option.selected_value == value %} active{% endif %}" data-option-index="{{ opos }}" data-value="{{ value | escape }}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <div class="product-detail-size">
                  <label>{{ option.name }}: <span data-selected-label="{{ opos }}">{{ option.selected_value }}</span></label>
                  <div class="size-options-grid">
                    {%- for value in option.values -%}
                      <button type="button" class="size-option{% if option.selected_value == value %} active{% endif %}" data-option-index="{{ opos }}" data-value="{{ value | escape }}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          <div class="product-detail-quantity">
            <label for="quantity">Menge:</label>
            <div class="quantity-selector">
              <button type="button" data-qty-minus aria-label="Menge verringern">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" max="5" readonly>
              <button type="button" data-qty-plus aria-label="Menge erhöhen">+</button>
            </div>
          </div>

          <div class="product-detail-actions">
            <button type="submit" class="btn-add-to-cart" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span data-add-label>{% if current_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
            </button>
          </div>
        {%- endform -%}
        <script type="application/json" data-variants>{{ product.variants | json }}</script>

        <div class="product-features">
          <div class="feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Versanddetails siehe Versandrichtlinie</span>
          </div>
          <div class="feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            <span>14 Tage Rückgaberecht</span>
          </div>
        </div>

        <div class="product-details-accordion">
          <div class="accordion-item">
            <button type="button" class="accordion-header" data-accordion>
              <span>Produktbeschreibung</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="accordion-content active">
              {{ product.description }}
            </div>
          </div>
          <div class="accordion-item">
            <button type="button" class="accordion-header" data-accordion>
              <span>Versand &amp; Rückgabe</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="accordion-content">
              <p>Details zu Versandkosten und Rückgabe findest du in unserer Versandrichtlinie.</p>
              <a href="/pages/versand">Versand &amp; Retouren</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt"
}
{% endschema %}
