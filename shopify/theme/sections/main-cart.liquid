<section class="page-wrap cart-page">
  <header class="page-head"><h1>Warenkorb</h1></header>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <a class="cart-item-media" href="{{ item.url }}">
              {% if item.image %}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="300" loading="lazy">{% endif %}
            </a>
            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}<p class="cart-item-variant">{{ item.variant.title }}</p>{% endunless %}
              <p class="cart-item-price">{{ item.final_price | money }}</p>
              <a class="cart-remove" href="{{ item.url_to_remove }}">Entfernen</a>
            </div>
            <div class="cart-item-qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Menge">
            </div>
            <div class="cart-item-total">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <p class="cart-total"><span>Zwischensumme</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="tax-note">Versand und Steuern werden an der Kasse berechnet.</p>
        <div class="cart-buttons">
          <button type="submit" name="update" class="btn btn-ghost">Aktualisieren</button>
          <button type="submit" name="checkout" class="btn">Zur Kasse</button>
        </div>
      </div>
    </form>
  {% else %}
    <div class="empty-state">
      <p>Dein Warenkorb ist leer.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Weiter einkaufen</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Warenkorb"
}
{% endschema %}
