<main class="site-info-page jm-cart">
  <header class="site-info-hero"><h1>Warenkorb</h1></header>
  <div class="site-info-content">
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="jm-cart-form">
      <div class="jm-cart-items">
        {% for item in cart.items %}
          <div class="jm-cart-item">
            <a class="jm-cart-media" href="{{ item.url }}">
              {% if item.image %}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="300" loading="lazy">{% endif %}
            </a>
            <div class="jm-cart-info">
              <a href="{{ item.url }}" class="jm-cart-title">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}<p class="jm-muted">{{ item.variant.title }}</p>{% endunless %}
              <p>{{ item.final_price | money }}</p>
              <a class="jm-muted" href="{{ item.url_to_remove }}">Entfernen</a>
            </div>
            <div class="jm-cart-qty"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Menge"></div>
            <div class="jm-cart-total">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      <div class="jm-cart-summary">
        <p class="jm-cart-sum"><span>Zwischensumme</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="jm-muted">Versand und Steuern werden an der Kasse berechnet.</p>
        <div class="jm-buttons">
          <button type="submit" name="update" class="site-info-button">Aktualisieren</button>
          <button type="submit" name="checkout" class="site-info-button jm-primary">Zur Kasse</button>
        </div>
      </div>
    </form>
  {% else %}
    <p>Dein Warenkorb ist leer.</p>
    <div class="site-info-actions"><a class="site-info-button" href="{{ routes.root_url }}">Weiter einkaufen</a></div>
  {% endif %}
  </div>
</main>

{% schema %}
{
  "name": "Warenkorb"
}
{% endschema %}
