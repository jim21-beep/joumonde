<main class="site-info-page">
  {%- case page.handle -%}
    {%- when 'about' -%}{% render 'page-about' %}
    {%- when 'faq' -%}{% render 'page-faq' %}
    {%- when 'agb' -%}{% render 'page-agb' %}
    {%- when 'versand' -%}{% render 'page-versand' %}
    {%- when 'impressum' -%}{% render 'page-impressum' %}
    {%- when 'cookie-policy' -%}{% render 'page-cookie-policy' %}
    {%- else -%}
      <header class="site-info-hero"><h1>{{ page.title }}</h1></header>
      <div class="site-info-content">{{ page.content }}</div>
  {%- endcase -%}
</main>

{% schema %}
{
  "name": "Seite"
}
{% endschema %}
