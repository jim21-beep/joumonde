<section id="home" class="hero">
  <div class="hero-content">
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.text }}</p>
    <button class="cta-btn" type="button" data-scroll-to="#old-money">{{ section.settings.button }}</button>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Entdecke Deinen Style" },
    { "type": "text", "id": "text", "label": "Text", "default": "Premium Fashion - Von klassischem Old Money bis zu komfortablen Casual Styles" },
    { "type": "text", "id": "button", "label": "Button", "default": "Jetzt Shoppen" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
