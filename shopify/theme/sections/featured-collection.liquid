{% liquid
  if section.settings.collection != blank
    assign col = section.settings.collection
  else
    assign col = collections.all
  endif
%}
<section class="page-wrap">
  <header class="page-head">
    <h2>{{ section.settings.title }}</h2>
  </header>
  <div class="product-grid">
    {% for product in col.products limit: section.settings.limit %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
  <p class="center"><a class="btn btn-ghost" href="{{ col.url }}">Alle Produkte ansehen</a></p>
</section>

{% schema %}
{
  "name": "Ausgewählte Produkte",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Ein erster Blick" },
    { "type": "collection", "id": "collection", "label": "Kollektion (leer = alle Produkte)" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Ausgewählte Produkte" }]
}
{% endschema %}
