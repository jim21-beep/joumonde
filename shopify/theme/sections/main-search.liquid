<main class="site-info-page">
  <header class="site-info-hero"><h1>Suche</h1></header>
  <div class="site-info-content">
    <form action="{{ routes.search_url }}" method="get" class="jm-search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Was suchst du?" aria-label="Suche">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="site-info-button">Suchen</button>
    </form>
    {% if search.performed %}
      {% paginate search.results by 24 %}
        <p class="jm-muted">{{ search.results_count }} Ergebnisse für "{{ search.terms | escape }}"</p>
        <div class="product-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  </div>
</main>

{% schema %}
{
  "name": "Suche"
}
{% endschema %}
